rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc(uid) { return /databases/$(database)/documents/admins/$(uid); }
    function activeAdmin() { return signedIn() && exists(adminDoc(request.auth.uid)) && get(adminDoc(request.auth.uid)).data.active == true; }
    function role() { return activeAdmin() ? get(adminDoc(request.auth.uid)).data.role : ''; }
    function reviewer() { return activeAdmin() && role() in ['reviewer','content_admin','super_admin','superadmin','admin']; }
    function contentAdmin() { return activeAdmin() && role() in ['content_admin','super_admin','superadmin','admin']; }
    function superAdmin() { return activeAdmin() && role() in ['super_admin','superadmin','admin']; }
    function canonicalRole() { return request.resource.data.role in ['reviewer','content_admin','super_admin']; }
    function validAdminWrite() { return request.resource.data.active is bool && request.resource.data.role is string && canonicalRole(); }
    function validStudentProfile() { return request.resource.data.keys().hasOnly(['name','email','role','identityNumber','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.role == 'student' && (request.resource.data.identityNumber == null || (request.resource.data.identityNumber is string && request.resource.data.identityNumber.size() >= 4 && request.resource.data.identityNumber.size() <= 32)); }
    function validSet() { return request.resource.data.ownerId == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 && request.resource.data.description is string && request.resource.data.description.size() <= 500 && request.resource.data.cardCount is int && request.resource.data.cardCount >= 0 && request.resource.data.cardCount <= 150; }
    function validStudentCard() { return request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 4000 && request.resource.data.answer is string && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 8000 && request.resource.data.difficulty is string && request.resource.data.tags is list && request.resource.data.tags.size() <= 10; }
    match /admins/{uid} { allow get: if signedIn() && (request.auth.uid == uid || superAdmin()); allow list: if superAdmin(); allow create, update: if superAdmin() && validAdminWrite(); allow delete: if false; }
    match /users/{uid} { allow get: if signedIn() && (request.auth.uid == uid || superAdmin()); allow list: if superAdmin(); allow create: if signedIn() && request.auth.uid == uid && validStudentProfile(); allow update: if signedIn() && request.auth.uid == uid && validStudentProfile(); allow delete: if false; }
    match /branches/{id} { allow read: if true; allow write: if superAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if superAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /resources/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /foundations/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /solutions/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /flashcards/{id} { allow read: if contentAdmin() || resource.data.active == true; allow write: if contentAdmin(); }
    match /studentFlashcardSets/{setId} {
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && validSet();
      match /cards/{cardId} {
        allow read, update, delete: if signedIn() && get(/databases/$(database)/documents/studentFlashcardSets/$(setId)).data.ownerId == request.auth.uid;
        allow create: if signedIn() && get(/databases/$(database)/documents/studentFlashcardSets/$(setId)).data.ownerId == request.auth.uid && validStudentCard();
      }
    }
    match /studentFlashcardShares/{setId} { allow read: if true; allow create, update: if signedIn() && request.resource.data.ownerId == request.auth.uid; allow delete: if signedIn() && resource.data.ownerId == request.auth.uid; }
    match /curriculumUnits/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /templates/{id} { allow read: if contentAdmin(); allow create, update, delete: if contentAdmin(); }
    match /sourceRegistry/{id} { allow read: if reviewer(); allow create, update, delete: if reviewer(); }
    match /suggestions/{id} { allow create: if (signedIn() || request.resource.data.contentType == 'flashcard') && request.resource.data.keys().hasOnly(['title','contentType','studentName','url','branchId','subjectId','level','foundationType','type','description','keywords','status','createdAt','updatedAt','question','answer']) && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 && request.resource.data.contentType in ['resource','foundation','flashcard'] && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 80 && request.resource.data.branchId is string && request.resource.data.branchId.size() > 0 && request.resource.data.branchId.size() <= 128 && request.resource.data.subjectId is string && request.resource.data.subjectId.size() > 0 && request.resource.data.subjectId.size() <= 128 && request.resource.data.status == 'pending' && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp && (request.resource.data.contentType == 'flashcard' ? (request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 1000 && request.resource.data.answer is string && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 3000) : (request.resource.data.url is string && request.resource.data.url.size() > 0)); allow read, update, delete: if reviewer(); }
    match /problemReports/{id} { allow create: if signedIn() && request.resource.data.keys().hasOnly(['sourceId','sourceTitle','kind','description','status','createdAt']) && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 2000 && request.resource.data.kind is string && request.resource.data.status == 'open' && request.resource.data.createdAt is timestamp; allow read, update, delete: if reviewer(); }
    match /adminLogs/{id} { allow read: if superAdmin(); allow create: if activeAdmin() && request.resource.data.adminUid == request.auth.uid && request.resource.data.role in ['reviewer','content_admin','super_admin','superadmin','admin']; allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
